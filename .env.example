# =======================================================
# MOIL Manganese AI Platform - Environment Variables
# =======================================================

# Server & Deployment Configuration
ENVIRONMENT=production
VERCEL=1

# Backend SQLite Database (Automatically falls back to /tmp on Vercel)
# DB_PATH=/tmp/manganese_operations.db

# Live External API Endpoints (Defaults pre-configured in code)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
ISRO_BHUVAN_CATALOG_URL=https://bhuvan.nrsc.gov.in

# Frontend Base API URL (Only needed if frontend and backend are deployed separately)
# VITE_API_BASE_URL=https://your-backend-domain.vercel.app
